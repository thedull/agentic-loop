  "cmd": "printf 'OPENROUTER_API_KEY=or-test\\nexport OPENROUTER_MODEL_KIMI=totally-dead/does-not-exist\\n' > .env; printf '.env\\n' > .gitignore; OPENROUTER_CATALOG_FILE=\"$FIXTURES/alias-liveness/catalog-full.json\" bash \"$PLUGIN_ROOT/scripts/doctor.sh\" 2>&1 | grep -i kimi",
  "checks": [
    {
      "type": "must_find",
      "strings": [
        "totally-dead/does-not-exist"
      ]
    }
  ],
