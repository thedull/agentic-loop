{
  "id": "hardened-504-bare-not-applicable-fails",
  "target": "acceptance 4 \u2014 'not applicable' without a reason is silence wearing a verdict",
  "kind": "bash-unit",
  "cmd": "e=$(\"$PLUGIN_ROOT/scripts/lib/hardened.sh\" verdicts \"$FIXTURES/hardened/verdicts_bare_na.md\" 2>&1 >/dev/null); c=$?; n=$(printf \"%s\" \"$e\"|grep -ci \"reason\"); printf '{\"c\":%s,\"names\":%s}' \"$c\" \"$n\"",
  "checks": [
    {
      "type": "exit_code",
      "equals": 0
    },
    {
      "type": "jq",
      "expr": ".c != 0 and .names >= 1"
    }
  ],
  "provenance": {
    "source": "hand",
    "date": "2026-08-08",
    "note": "spec 005 Red Gate"
  }
}