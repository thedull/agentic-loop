      "type": "exit_code",
      "equals": 0
    },
    {
      "type": "jq",
      "expr": ".findings[0] | (.location.file | length) > 0 and ((.searched | length) > 0)"
    }
  ],
  "provenance": {
    "source": "hand",
    "date": "2026-08-10"
  }
}
