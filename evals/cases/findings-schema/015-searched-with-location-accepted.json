{
  "id": "findings-schema-015-searched-with-location-accepted",
  "target": "validate_envelope.jq — searched alongside a real location is not an error",
  "kind": "bash-unit",
  "cmd": "jq -e -f \"$PLUGIN_ROOT/scripts/lib/validate_envelope.jq\" < \"$FIXTURES/findings/searched-with-location.json\" 2>&1",
  "checks": [
