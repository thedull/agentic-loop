{
  "id": "common-safety-003-keys-are-not-exported-to-children",
  "target": "load_env's own comment says it does NOT export to children beyond this process; set -a does exactly that, so every subprocess inherits the credentials",
  "kind": "bash-unit",
  "cmd": "printf 'OPENROUTER_API_KEY=secret-value\\n' > .env; bash -c 'source \"$PLUGIN_ROOT/scripts/lib/common.sh\" >/dev/null 2>&1; load_env; bash -c \"echo child-sees=\\${OPENROUTER_API_KEY:-unset}\"'",
  "checks": [
    {
      "type": "must_find",
      "strings": [
        "child-sees=unset"
      ]
    }
  ],
  "provenance": {
    "source": "live adversary review 2026-08-11",
    "date": "2026-08-11"
  }
}
